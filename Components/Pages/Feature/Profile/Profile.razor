@page "/cms/profile"
@layout MainLayout
@attribute [Authorize]
@using System.Text.Json.Serialization
@using GmbhCmsPortalApp.Components.Service
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject UserProfileState ProfileState

<div class="max-w-4xl mx-auto space-y-8">

    <!-- Page Header -->
    <div class="flex items-center justify-between border-b border-[#E6E0DD] pb-6">
        <div class="flex items-center space-x-4">
            <button @onclick="GoBack"
                    class="bg-white border border-[#D9D0CC] hover:bg-[#F5EFEE] text-[#5C1D24] p-2 rounded-md transition cursor-pointer flex items-center justify-center"
                    title="Back">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
            </button>
            <div>
                <span class="text-xs uppercase text-[#5C1D24] font-medium block mb-1 tracking-normal">
                    CMS Portal • Account Settings
                </span>
                <h1 class="text-2xl font-semibold text-[#2D2424]">
                    Profile
                </h1>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <!-- Loading UI -->
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-12 text-center text-[#735A5A]">
            <svg class="animate-spin h-8 w-8 text-[#5C1D24] mx-auto mb-3" xmlns="http://www.w3.org/2000/svg" fill="none"
                 viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p class="text-sm font-medium">Loading profile information...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <!-- Error Notification -->
        <div class="bg-[#FDF8F8] border-l-4 border-[#5C1D24] text-[#5C1D24] p-4 rounded-r-md text-sm flex items-center space-x-2">
            <span>@errorMessage</span>
        </div>
    }
    else
    {
        <!-- Profile Overview & Avatar Card -->
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-8 shadow-sm flex flex-col md:flex-row items-center gap-6">
            <div class="relative">
                <img src="@(string.IsNullOrEmpty(profileModel.ProfileImage) ? "/Logo/default_avatar.png" : profileModel.ProfileImage)"
                     alt="Admin Avatar"
                     class="w-24 h-24 rounded-full object-cover border-2 border-[#5C1D24]"/>
                <div class="absolute bottom-0 right-0 bg-gray-400 text-white p-2 rounded-full cursor-not-allowed shadow-md opacity-60"
                     title="Read Only">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                </div>
            </div>
            <div class="text-center md:text-left space-y-1">
                <h2 class="text-xl font-semibold text-[#2D2424]">@profileModel.FullName</h2>
                <p class="text-sm text-[#5C4D4D]">@profileModel.Email</p>
                <span class="inline-block bg-[#F5EFEE] text-[#5C1D24] text-[11px] uppercase font-medium px-2.5 py-1 rounded">
                    @profileModel.Role
                </span>
            </div>
        </div>

        <!-- Edit Profile Form Card (Read Only) -->
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-8 shadow-sm">
            <EditForm Model="profileModel">
                <fieldset disabled class="space-y-6">
                    <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal border-b border-[#E6E0DD] pb-2">
                        Personal Information
                    </h3>

                    <!-- Full Name & Username -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                                Full Name
                            </label>
                            <InputText @bind-Value="profileModel.FullName"
                                       class="w-full bg-gray-100 border border-[#D9D0CC] px-3.5 py-3 text-sm text-gray-600 focus:outline-none rounded-md cursor-not-allowed"/>
                        </div>
                        <div>
                            <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                                Username
                            </label>
                            <InputText @bind-Value="profileModel.Username"
                                       class="w-full bg-gray-100 border border-[#D9D0CC] px-3.5 py-3 text-sm text-gray-600 focus:outline-none rounded-md cursor-not-allowed"/>
                        </div>
                    </div>

                    <!-- Email & Role -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                                Email Address
                            </label>
                            <InputText @bind-Value="profileModel.Email"
                                       class="w-full bg-gray-100 border border-[#D9D0CC] px-3.5 py-3 text-sm text-gray-600 focus:outline-none rounded-md cursor-not-allowed"/>
                        </div>
                        <div>
                            <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                                Role
                            </label>
                            <InputText @bind-Value="profileModel.Role"
                                       class="w-full bg-gray-100 border border-[#D9D0CC] px-3.5 py-3 text-sm text-gray-600 focus:outline-none rounded-md cursor-not-allowed"/>
                        </div>
                    </div>
                </fieldset>
            </EditForm>
        </div>
    }
</div>

@code {
    private AdminProfileModel profileModel = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserProfileAsync();
    }

    private async Task LoadUserProfileAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // ProfileState တွင် Data ရှိပြီးသားဖြစ်ပါက တိုက်ရိုက်ယူမည် (Cache usage)
            if (!ProfileState.IsLoaded)
            {
                await ProfileState.InitializeAsync();
            }

            if (ProfileState.Profile != null)
            {
                profileModel = new AdminProfileModel
                {
                    FullName = ProfileState.Profile.FullName ?? "",
                    Username = ProfileState.Profile.Username ?? "",
                    Email = ProfileState.Profile.Email ?? "",
                    Role = ProfileState.Profile.Role ?? "",
                    ProfileImage = ProfileState.Profile.ProfileImage ?? ""
                };
            }
            else
            {
                errorMessage = "Failed to load user profile. Please login again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error fetching profile: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/cms/dashboard");
    }

    public class AdminProfileModel
    {
        [JsonPropertyName("fullName")] public string FullName { get; set; } = "";

        [JsonPropertyName("username")] public string Username { get; set; } = "";

        [JsonPropertyName("email")] public string Email { get; set; } = "";

        [JsonPropertyName("role")] public string Role { get; set; } = "";

        [JsonPropertyName("profileImage")] public string ProfileImage { get; set; } = "";
    }
}