@page "/cms/edit-leadership"
@layout MainLayout
@attribute [Authorize]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="max-w-5xl mx-auto space-y-8">

    <!-- Page Header -->
    <div class="flex items-center justify-between border-b border-[#E6E0DD] pb-6">
        <div class="flex items-center space-x-4">
            <!-- Back Button -->
            <button @onclick="GoBack"
                    class="bg-white border border-[#D9D0CC] hover:bg-[#F5EFEE] text-[#5C1D24] p-2 rounded-md transition cursor-pointer flex items-center justify-center"
                    title="Back">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
            </button>
            <div>
                <span class="text-xs uppercase text-[#5C1D24] font-medium block mb-1 tracking-normal">
                    CMS Portal • Content Management
                </span>
                <h1 class="text-2xl font-semibold text-[#2D2424]">
                    Manage Leadership Section
                </h1>
            </div>
        </div>

        <!-- Add New Leader Button -->
        <button @onclick="OpenCreateModal"
                class="bg-[#5C1D24] hover:bg-[#4A171D] text-[#FCFBFA] px-5 py-2.5 text-xs uppercase font-medium rounded-md transition cursor-pointer flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add New Leader
        </button>
    </div>

    <!-- Section Header Settings -->
    <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm space-y-4">
        <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal border-b border-[#E6E0DD] pb-2">
            Section Header Settings
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                    Subtitle (e.g., BOARD OF DIRECTORS)
                </label>
                <input type="text" @bind="sectionSubtitle"
                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
            </div>
            <div>
                <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                    Main Title (e.g., Meet Our Leadership)
                </label>
                <input type="text" @bind="sectionTitle"
                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
            </div>
        </div>
    </div>

    <!-- Leadership List Section -->
    <div class="space-y-4">
        <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal">
            Leaders List (@leadersList.Count)
        </h3>

        @if (isLoadingPage)
        {
            <div class="flex flex-col items-center justify-center py-16 space-y-4 bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg">
                <svg class="animate-spin h-8 w-8 text-[#5C1D24]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <p class="text-xs uppercase font-medium text-[#735A5A]">Loading leaders profiles...</p>
            </div>
        }
        else if (leadersList.Count == 0)
        {
            <div class="text-center py-12 bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg">
                <p class="text-sm text-[#735A5A]">No leaders found. Click "Add New Leader" to create one.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @foreach (var leader in leadersList)
                {
                    <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg overflow-hidden shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="p-6 flex flex-col items-center text-center border-b border-[#E6E0DD] bg-white">
                                <div class="w-24 h-24 rounded-full overflow-hidden mb-4 border border-[#E6E0DD] flex items-center justify-center bg-gray-50">
                                    @if (string.IsNullOrEmpty(leader.ImageUrl))
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[#D9D0CC]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <img src="@leader.ImageUrl" alt="@leader.Name" class="w-full h-full object-cover"/>
                                    }
                                </div>
                                <span class="text-[10px] uppercase font-semibold text-[#5C1D24] tracking-wider mb-1">@leader.Role</span>
                                <h4 class="text-base font-bold text-[#2D2424]">@leader.Name</h4>
                            </div>
                            <div class="p-5 space-y-2">
                                <p class="text-xs text-[#5C4D4D] line-clamp-4">@leader.Bio</p>
                            </div>
                        </div>

                        <!-- Card Actions (Edit / Delete) -->
                        <div class="px-5 py-3 bg-white border-t border-[#E6E0DD] flex items-center justify-between">
                            <button @onclick="() => OpenEditModal(leader)"
                                    class="text-xs uppercase font-medium text-[#5C1D24] hover:underline flex items-center gap-1 cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                                Edit
                            </button>
                            <button @onclick="() => PromptDelete(leader)"
                                    class="text-xs uppercase font-medium text-red-700 hover:underline flex items-center gap-1 cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                                Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- Create / Edit Modal Form -->
@if (isModalOpen)
{
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg max-w-lg w-full p-6 shadow-xl space-y-6 max-h-[90vh] overflow-y-auto">

            <div class="flex items-center justify-between border-b border-[#E6E0DD] pb-4">
                <h3 class="text-base font-semibold text-[#2D2424]">
                    @(isEditMode ? "Edit Leader Profile" : "Add New Leader Profile")
                </h3>
                <button @onclick="CloseModal" class="text-[#735A5A] hover:text-[#2D2424]">
                    ✕
                </button>
            </div>

            <EditForm Model="activeLeader" OnValidSubmit="SaveLeader">
                <div class="space-y-4">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-1">Full Name</label>
                            <InputText @bind-Value="activeLeader.Name"
                                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                        </div>
                        <div>
                            <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-1">Role / Position (e.g., FOUNDER)</label>
                            <InputText @bind-Value="activeLeader.Role"
                                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-1">Biography / Description</label>
                        <InputTextArea @bind-Value="activeLeader.Bio" rows="5"
                                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    </div>

                    <div>
                        <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-1">Profile Image</label>
                        <InputFile OnChange="HandleFileSelection"
                                   class="w-full bg-white border border-[#D9D0CC] p-2 text-xs text-[#2D2424] rounded-md cursor-pointer file:mr-3 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-medium file:bg-[#5C1D24] file:text-[#FCFBFA]"/>

                        @if (isUploadingImage)
                        {
                            <div class="mt-3 flex items-center gap-2 text-xs text-[#735A5A]">
                                <svg class="animate-spin h-4 w-4 text-[#5C1D24]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                </svg>
                                Uploading image...
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(previewImageUrl))
                        {
                            <div class="mt-3 w-24 h-24 rounded-full overflow-hidden border border-[#E6E0DD] mx-auto">
                                <img src="@previewImageUrl" alt="Preview" class="w-full h-full object-cover"/>
                            </div>
                        }
                    </div>

                    <div class="flex justify-end gap-3 pt-4 border-t border-[#E6E0DD]">
                        <button type="button" @onclick="CloseModal"
                                class="bg-white border border-[#D9D0CC] text-[#735A5A] hover:bg-[#F5EFEE] px-4 py-2 text-xs uppercase font-medium rounded-md transition">
                            Cancel
                        </button>
                        <button type="submit" disabled="@isSaving"
                                class="bg-[#5C1D24] hover:bg-[#4A171D] text-[#FCFBFA] px-5 py-2 text-xs uppercase font-medium rounded-md transition flex items-center gap-2 disabled:opacity-50">
                            @if (isSaving)
                            {
                                <svg class="animate-spin h-3.5 w-3.5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                </svg>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Profile</span>
                            }
                        </button>
                    </div>

                </div>
            </EditForm>

        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (isDeleteModalOpen)
{
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg max-w-sm w-full p-6 shadow-xl space-y-6 text-center">

            <div class="w-12 h-12 rounded-full bg-red-100 text-red-700 flex items-center justify-center mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
            </div>

            <div class="space-y-2">
                <h3 class="text-base font-semibold text-[#2D2424]">Delete Leader Profile</h3>
                <p class="text-xs text-[#5C4D4D]">
                    Are you sure you want to delete <span class="font-semibold text-[#2D2424]">"@leaderToDelete?.Name"</span>? This action cannot be undone.
                </p>
            </div>

            <div class="flex justify-center gap-3 pt-2">
                <button type="button" @onclick="CloseDeleteModal" disabled="@isDeleting"
                        class="flex-1 bg-white border border-[#D9D0CC] text-[#735A5A] hover:bg-[#F5EFEE] px-4 py-2 text-xs uppercase font-medium rounded-md transition disabled:opacity-50">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmDelete" disabled="@isDeleting"
                        class="flex-1 bg-red-700 hover:bg-red-800 text-white px-4 py-2 text-xs uppercase font-medium rounded-md transition flex items-center justify-center gap-2 disabled:opacity-50">
                    @if (isDeleting)
                    {
                        <svg class="animate-spin h-3.5 w-3.5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span>Delete</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

@code {
    private string sectionSubtitle = "BOARD OF DIRECTORS";
    private string sectionTitle = "Meet Our Leadership";
    private string currentLang = "en";

    private List<LeaderModel> leadersList = new();

    // Loading State Variables
    private bool isLoadingPage = true;
    private bool isUploadingImage = false;
    private bool isSaving = false;
    private bool isDeleting = false;

    private bool isModalOpen = false;
    private bool isEditMode = false;
    private LeaderModel activeLeader = new();
    private string previewImageUrl = "";

    private bool isDeleteModalOpen = false;
    private LeaderModel? leaderToDelete = null;

    private const string BucketName = "gmbh";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity is null || !user.Identity.IsAuthenticated)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            await LoadLeadersAsync();
            StateHasChanged();
        }
    }

    private async Task LoadLeadersAsync()
    {
        isLoadingPage = true;
        StateHasChanged();

        try
        {
            var response = await Http.GetFromJsonAsync<List<LeaderModel>>($"api/cms/leadership?lang={currentLang}");
            if (response != null)
            {
                leadersList.Clear();
                foreach (var leader in response)
                {
                    if (!string.IsNullOrEmpty(leader.ImageUrl) && !leader.ImageUrl.StartsWith("http"))
                    {
                        leader.ImageUrl = await GetImageUrlAsync(BucketName, leader.ImageUrl);
                    }

                    leadersList.Add(leader);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading leaders: {ex.Message}");
        }
        finally
        {
            isLoadingPage = false;
            StateHasChanged();
        }
    }

    private async Task<string> GetImageUrlAsync(string bucketName, string key)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PresignedUrlResponseModel>($"api/cms/media/presigned-url?bucketName={bucketName}&key={key}");
            return response?.PresignedUrl ?? string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/cms/dashboard");
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        activeLeader = new LeaderModel();
        previewImageUrl = "";
        isModalOpen = true;
    }

    private async Task OpenEditModal(LeaderModel leader)
    {
        isEditMode = true;
        activeLeader = new LeaderModel
        {
            Id = leader.Id,
            Name = leader.Name,
            Role = leader.Role,
            Bio = leader.Bio,
            ImageUrl = leader.ImageUrl
        };
        previewImageUrl = leader.ImageUrl;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            isUploadingImage = true;
            StateHasChanged();

            try
            {
                using var content = new MultipartFormDataContent();
                var fileStream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                var streamContent = new StreamContent(fileStream);
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

                content.Add(streamContent, "file", file.Name);

                var response = await Http.PostAsync($"api/cms/media/upload?bucketName={BucketName}", content);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<UploadResponseModel>();

                    if (result != null)
                    {
                        activeLeader.ImageUrl = result.FileName;
                        previewImageUrl = await GetImageUrlAsync(BucketName, result.FileName);
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
            finally
            {
                isUploadingImage = false;
                StateHasChanged();
            }
        }
    }

    private async Task SaveLeader()
    {
        isSaving = true;
        StateHasChanged();

        try
        {
            HttpResponseMessage response;

            if (isEditMode)
            {
                response = await Http.PutAsJsonAsync($"api/cms/leadership/{activeLeader.Id}?lang={currentLang}", activeLeader);
            }
            else
            {
                response = await Http.PostAsJsonAsync($"api/cms/leadership?lang={currentLang}", activeLeader);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadLeadersAsync();
                isModalOpen = false;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Failed to save leader: {errorContent}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving leader: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void PromptDelete(LeaderModel leader)
    {
        leaderToDelete = leader;
        isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        leaderToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (leaderToDelete != null)
        {
            isDeleting = true;
            StateHasChanged();

            try
            {
                var response = await Http.DeleteAsync($"api/cms/leadership/{leaderToDelete.Id}");
                if (response.IsSuccessStatusCode)
                {
                    leadersList.Remove(leaderToDelete);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting leader: {ex.Message}");
            }
            finally
            {
                isDeleting = false;
                StateHasChanged();
            }
        }

        CloseDeleteModal();
    }

    public class LeaderModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Role { get; set; } = "";
        public string Bio { get; set; } = "";
        public string ImageUrl { get; set; } = "";
    }

    public class UploadResponseModel
    {
        public string Message { get; set; } = "";
        public string ETag { get; set; } = "";
        public string FileName { get; set; } = "";
    }

    public class PresignedUrlResponseModel
    {
        public string PresignedUrl { get; set; } = "";
    }
}