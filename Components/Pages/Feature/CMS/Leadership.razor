@page "/cms/edit-leadership"
@layout MainLayout
@attribute [Authorize]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using GmbhCmsPortalApp.Components.Common
@using GmbhCmsPortalApp.Components.Shared

<!-- Notification Toast System -->
<ToastNotification Message="@toastMessage" Type="@toastType" OnDismiss="DismissToast" />

<div class="max-w-5xl mx-auto space-y-8">

    <!-- Page Header & Language Switcher -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[#E6E0DD] pb-6 gap-4">
        <div class="flex items-center space-x-4">
            <button @onclick="GoBack"
                    class="bg-white border border-[#D9D0CC] hover:bg-[#F5EFEE] text-[#5C1D24] p-2 rounded-md transition cursor-pointer flex items-center justify-center"
                    title="Back">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </button>
            <div>
                <span class="text-xs uppercase text-[#5C1D24] font-medium block mb-1 tracking-normal">
                    CMS Portal • Content Management
                </span>
                <h1 class="text-2xl font-semibold text-[#2D2424]">
                    Manage Leadership Section
                </h1>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <LanguageSwitcher @bind-CurrentLanguage="CurrentLang"
                              HasEnglishData="@hasEnglishLeaders"
                              HasGermanData="@hasGermanLeaders" />

            <button @onclick="OpenCreateModal"
                    class="bg-[#5C1D24] hover:bg-[#4A171D] text-[#FCFBFA] px-5 py-2.5 text-xs uppercase font-medium rounded-md transition cursor-pointer flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add New Leader
            </button>
        </div>
    </div>

    <!-- Language Reminder Banner -->
    <div class="bg-[#5C1D24]/10 border border-[#5C1D24]/20 p-3 rounded-md text-xs text-[#5C1D24] font-medium flex justify-between items-center">
        <span>You are editing: <strong class="uppercase">@(currentLang == "en" ? "English (EN)" : "German (DE)")</strong>. Remember to check both language tabs before saving!</span>
        <button type="button" @onclick="SwitchLanguage" class="underline font-bold hover:opacity-80 cursor-pointer">
            Switch to @(currentLang == "en" ? "German 🇩🇪" : "English 🇬🇧") ➔
        </button>
    </div>
    
    <!-- Section Header Settings Card -->
    <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-[#E6E0DD] pb-2">
            <div class="flex items-center gap-2">
                <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal">
                    Section Header Settings
                </h3>
                <span class="text-[10px] bg-[#E6E0DD] text-[#5C1D24] px-2 py-0.5 rounded font-bold uppercase">
                    @currentLang
                </span>
            </div>
            <button @onclick="SaveHeaderSettings" disabled="@isSavingHeader"
                    class="bg-[#5C1D24] hover:bg-[#4A171D] text-white px-4 py-1.5 text-xs font-medium rounded-md transition flex items-center gap-1.5 disabled:opacity-50 cursor-pointer">
                @if (isSavingHeader)
                {
                    <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save Header (@currentLang.ToUpper())</span>
                }
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                    Subtitle (@currentLang.ToUpper())
                </label>
                <input type="text" @bind="sectionSubtitle"
                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md" />
            </div>
            <div>
                <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                    Main Title (@currentLang.ToUpper())
                </label>
                <input type="text" @bind="sectionTitle"
                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md" />
            </div>
        </div>
    </div>

    <!-- Leaders List Section -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal">
                Leaders List (@leadersList.Count) - Language: <span class="uppercase font-bold">@currentLang</span>
            </h3>
        </div>

        @if (isPageLoading)
        {
            <div class="flex flex-col items-center justify-center py-12 space-y-3 bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg">
                <svg class="animate-spin h-8 w-8 text-[#5C1D24]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="text-xs font-medium text-[#5C4D4D]">Loading leadership profiles (@currentLang)...</span>
            </div>
        }
        else if (!leadersList.Any())
        {
            <div class="p-8 text-center bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg text-xs text-[#5C4D4D]">
                No leadership profiles found for "@currentLang.ToUpper()". Click "Add New Leader" to create one.
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @foreach (var leader in leadersList)
                {
                    <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg overflow-hidden shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="p-6 flex flex-col items-center text-center border-b border-[#E6E0DD] bg-white">
                                <div class="w-24 h-24 rounded-full overflow-hidden mb-4 border border-[#E6E0DD] bg-gray-50 flex items-center justify-center">
                                    @if (!string.IsNullOrEmpty(leader.ImageUrl))
                                    {
                                        <img src="@leader.ImageUrl" alt="@leader.Name" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400">No Image</span>
                                    }
                                </div>
                                <span class="text-[10px] uppercase font-semibold text-[#5C1D24] tracking-wider mb-1">@leader.Role</span>
                                <h4 class="text-base font-bold text-[#2D2424]">@leader.Name</h4>
                            </div>
                            <div class="p-5 space-y-2">
                                <p class="text-xs text-[#5C4D4D] line-clamp-4">@leader.Bio</p>
                            </div>
                        </div>

                        <div class="px-5 py-3 bg-white border-t border-[#E6E0DD] flex items-center justify-between">
                            <button @onclick="() => OpenEditModal(leader)"
                                    class="text-xs uppercase font-medium text-[#5C1D24] hover:underline flex items-center gap-1 cursor-pointer">
                                Edit
                            </button>
                            <button @onclick="() => PromptDelete(leader)"
                                    class="text-xs uppercase font-medium text-red-700 hover:underline flex items-center gap-1 cursor-pointer">
                                Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- Delete Confirmation Modal Component -->
<DeleteConfirmationModal IsOpen="@isDeleteModalOpen"
                         ItemName="@(leaderToDelete?.Name ?? string.Empty)"
                         ButtonText="Delete Leader"
                         IsDeleting="@isDeleting"
                         OnCancel="CloseDeleteModal"
                         OnConfirm="ExecuteDelete" />

<!-- Dual Language Create/Edit Modal -->
@if (isModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl overflow-hidden border border-[#E6E0DD] space-y-4">

            <div class="px-6 py-4 bg-[#FCFBFA] border-b border-[#E6E0DD] flex justify-between items-center">
                <h3 class="text-sm font-semibold uppercase text-[#5C1D24]">
                    @(isEditMode ? $"Edit Leader Profile ({currentLang.ToUpper()})" : "Add New Leader (EN & DE)")
                </h3>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="p-6 space-y-4 text-xs max-h-[75vh] overflow-y-auto">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Full Name *</label>
                        <input type="text" @bind="createModel.Name" placeholder="e.g. Win Htein Lin"
                               class="w-full bg-white border border-[#D9D0CC] px-3 py-2 text-sm rounded focus:outline-none focus:border-[#5C1D24]" />
                    </div>

                    <div>
                        <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Profile Image</label>
                        <div class="flex items-center gap-3">
                            <div class="relative flex-1">
                                <InputFile OnChange="HandleFileSelected" accept="image/*"
                                           class="block w-full text-xs text-gray-500 file:mr-3 file:py-2 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-[#5C1D24] file:text-white hover:file:bg-[#4A171D] cursor-pointer border border-[#D9D0CC] rounded" />
                            </div>
                            @if (isUploading)
                            {
                                <svg class="animate-spin h-5 w-5 text-[#5C1D24]" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(previewImageUrl))
                        {
                            <div class="mt-2 flex items-center gap-2">
                                <img src="@previewImageUrl" alt="Preview"
                                     class="w-10 h-10 object-cover rounded-full border border-[#E6E0DD]" />
                                <span class="text-[10px] text-emerald-700 font-medium truncate">Attached: @selectedFileName</span>
                            </div>
                        }
                    </div>
                </div>

                <hr class="border-[#E6E0DD]" />

                <!-- English Details -->
                @if (!isEditMode || currentLang == "en")
                {
                    <div class="space-y-3 bg-[#FCFBFA] p-4 rounded-md border border-[#E6E0DD]">
                        <h4 class="font-bold text-[#5C1D24] uppercase text-[11px] flex items-center gap-2">
                            🇬🇧 English Details
                        </h4>
                        <div>
                            <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Role (EN)</label>
                            <input type="text" @bind="createModel.RoleEn" placeholder="e.g. Founder"
                                   class="w-full bg-white border border-[#D9D0CC] px-3 py-2 text-sm rounded focus:outline-none focus:border-[#5C1D24]" />
                        </div>
                        <div>
                            <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Bio (EN)</label>
                            <textarea @bind="createModel.BioEn" rows="3" placeholder="English bio..."
                                      class="w-full bg-white border border-[#D9D0CC] px-3 py-2 text-sm rounded focus:outline-none focus:border-[#5C1D24]"></textarea>
                        </div>
                    </div>
                }

                <!-- German Details -->
                @if (!isEditMode || currentLang == "de")
                {
                    <div class="space-y-3 bg-[#FCFBFA] p-4 rounded-md border border-[#E6E0DD]">
                        <h4 class="font-bold text-[#5C1D24] uppercase text-[11px] flex items-center gap-2">
                            🇩🇪 German Details
                        </h4>
                        <div>
                            <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Role (DE)</label>
                            <input type="text" @bind="createModel.RoleDe" placeholder="e.g. Gründer"
                                   class="w-full bg-white border border-[#D9D0CC] px-3 py-2 text-sm rounded focus:outline-none focus:border-[#5C1D24]" />
                        </div>
                        <div>
                            <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Bio (DE)</label>
                            <textarea @bind="createModel.BioDe" rows="3" placeholder="German bio..."
                                      class="w-full bg-white border border-[#D9D0CC] px-3 py-2 text-sm rounded focus:outline-none focus:border-[#5C1D24]"></textarea>
                        </div>
                    </div>
                }

                <div class="px-6 py-3 bg-[#FCFBFA] border-t border-[#E6E0DD] flex justify-end gap-2">
                    <button @onclick="CloseModal" type="button"
                            class="px-4 py-2 text-xs font-medium text-[#5C4D4D] border border-[#D9D0CC] rounded hover:bg-[#F5EFEE] cursor-pointer">
                        Cancel
                    </button>
                    <button @onclick="SaveLeader" disabled="@(isSaving || isUploading)" type="button"
                            class="px-4 py-2 text-xs font-medium text-white bg-[#5C1D24] hover:bg-[#4A171D] rounded disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                        @if (isSaving)
                        {
                            <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        }
                        <span>Save Leader</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string currentLang = "en";

    public string CurrentLang
    {
        get => currentLang;
        set
        {
            if (currentLang != value)
            {
                currentLang = value;
                _ = LoadDataForCurrentLangAsync();
            }
        }
    }

    private string sectionSubtitle = string.Empty;
    private string sectionTitle = string.Empty;

    private List<ApiLeaderItem> leadersList = new();

    private bool hasEnglishLeaders;
    private bool hasGermanLeaders;

    private bool isPageLoading = true;
    private bool isSaving;
    private bool isDeleting;
    private bool isUploading;
    private bool isSavingHeader;

    private bool isModalOpen;
    private bool isEditMode;
    private ApiLeaderItem activeLeader = new();

    private string previewImageUrl = string.Empty;
    private string selectedFileName = string.Empty;
    private string initialImageUrl = string.Empty;

    private bool isDeleteModalOpen;
    private ApiLeaderItem? leaderToDelete;

    private string? toastMessage;
    private ToastNotification.ToastType toastType = ToastNotification.ToastType.Success;

    private const string BucketName = "gmbh";
    private CreateLeaderDto createModel = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity is null || !authState.User.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await CheckLanguageDataAvailabilityAsync();
        await LoadDataForCurrentLangAsync();
    }

    private async Task CheckLanguageDataAvailabilityAsync()
    {
        try
        {
            var enTask = Http.GetFromJsonAsync<List<ApiLeaderItem>>("api/cms/leadership?lang=en");
            var deTask = Http.GetFromJsonAsync<List<ApiLeaderItem>>("api/cms/leadership?lang=de");

            await Task.WhenAll(enTask, deTask);

            hasEnglishLeaders = enTask.Result?.Any() ?? false;
            hasGermanLeaders = deTask.Result?.Any() ?? false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] CheckLanguageDataAvailability failed: {ex.Message}");
        }
    }

    private async Task LoadDataForCurrentLangAsync()
    {
        isPageLoading = true;
        StateHasChanged();
        await Task.WhenAll(LoadHeaderSettingsAsync(), LoadLeadersAsync());
        isPageLoading = false;
        StateHasChanged();
    }

    private async Task LoadHeaderSettingsAsync()
    {
        try
        {
            var header = await Http.GetFromJsonAsync<HeaderResponseDto>($"api/cms/leadership/header?lang={currentLang}");
            if (header != null)
            {
                sectionSubtitle = header.Subtitle ?? string.Empty;
                sectionTitle = header.MainTitle ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] LoadHeaderSettingsAsync: {ex.Message}");
        }
    }

    private async Task SaveHeaderSettings()
    {
        try
        {
            isSavingHeader = true;
            var request = new UpdateHeaderRequest
            {
                Subtitle = sectionSubtitle,
                MainTitle = sectionTitle
            };

            var response = await Http.PutAsJsonAsync($"api/cms/leadership/header?lang={currentLang}", request);
            if (response.IsSuccessStatusCode)
            {
                ShowToast("Header settings updated successfully!", ToastNotification.ToastType.Success);
            }
            else
            {
                ShowToast("Failed to update header settings.", ToastNotification.ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Save Error: {ex.Message}", ToastNotification.ToastType.Error);
        }
        finally
        {
            isSavingHeader = false;
        }
    }

    private async Task LoadLeadersAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<ApiLeaderItem>>($"api/cms/leadership?lang={currentLang}");
            leadersList.Clear();
            if (response != null)
            {
                foreach (var leader in response)
                {
                    if (!string.IsNullOrEmpty(leader.ImageUrl) && !leader.ImageUrl.StartsWith("http"))
                    {
                        leader.ImageUrl = await GetImageUrlAsync(BucketName, leader.ImageUrl);
                    }
                    leadersList.Add(leader);
                }
            }

            if (currentLang == "en") hasEnglishLeaders = leadersList.Any();
            if (currentLang == "de") hasGermanLeaders = leadersList.Any();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] LoadLeadersAsync: {ex.Message}");
        }
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        createModel = new CreateLeaderDto();
        initialImageUrl = string.Empty;
        previewImageUrl = string.Empty;
        selectedFileName = string.Empty;
        isModalOpen = true;
    }

    private async Task OpenEditModal(ApiLeaderItem leader)
    {
        isEditMode = true;
        activeLeader = leader;
        previewImageUrl = string.Empty;
        selectedFileName = string.Empty;

        try
        {
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var response = await Http.GetAsync($"api/cms/leadership/{leader.Id}/detail");

            if (response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadFromJsonAsync<CreateLeaderDto>(options);
                if (detail != null)
                {
                    createModel = detail;
                    initialImageUrl = detail.ImageUrl;

                    if (!string.IsNullOrEmpty(createModel.ImageUrl))
                    {
                        previewImageUrl = createModel.ImageUrl.StartsWith("http")
                            ? createModel.ImageUrl
                            : await GetImageUrlAsync(BucketName, createModel.ImageUrl);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] OpenEditModal Exception: {ex.Message}");
        }

        isModalOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseModal()
    {
        if (!string.IsNullOrEmpty(createModel.ImageUrl) && createModel.ImageUrl != initialImageUrl)
        {
            await DeleteUploadedImageAsync(createModel.ImageUrl);
        }

        isModalOpen = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        selectedFileName = file.Name;

        try
        {
            isUploading = true;
            StateHasChanged();

            const long maxFileSize = 40 * 1024 * 1024; // 40 MB

            using var fileStream = file.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await fileStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(memoryStream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(streamContent, "file", file.Name);

            var response = await Http.PostAsync($"api/cms/media/upload?bucketName={BucketName}", content);

            if (response.IsSuccessStatusCode)
            {
                var uploadResult = await response.Content.ReadFromJsonAsync<FileUploadResponseModel>();

                if (uploadResult != null && !string.IsNullOrEmpty(uploadResult.FileName))
                {
                    if (!string.IsNullOrEmpty(createModel.ImageUrl) && createModel.ImageUrl != initialImageUrl)
                    {
                        await DeleteUploadedImageAsync(createModel.ImageUrl);
                    }

                    createModel.ImageUrl = uploadResult.FileName;
                    previewImageUrl = await GetImageUrlAsync(BucketName, uploadResult.FileName);
                    ShowToast("Image uploaded successfully!", ToastNotification.ToastType.Success);
                }
            }
            else
            {
                ShowToast($"Upload failed: {response.StatusCode}", ToastNotification.ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Upload error: {ex.Message}", ToastNotification.ToastType.Error);
        }
        finally
        {
            isUploading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveLeader()
    {
        if (string.IsNullOrWhiteSpace(createModel.Name))
        {
            ShowToast("Please enter Full Name.", ToastNotification.ToastType.Error);
            return;
        }

        try
        {
            isSaving = true;
            var response = isEditMode
                ? await Http.PutAsJsonAsync($"api/cms/leadership/{activeLeader.Id}", createModel)
                : await Http.PostAsJsonAsync("api/cms/leadership", createModel);

            if (response.IsSuccessStatusCode)
            {
                initialImageUrl = createModel.ImageUrl;
                await LoadDataForCurrentLangAsync();
                await CheckLanguageDataAvailabilityAsync();
                isModalOpen = false;
                ShowToast(isEditMode ? "Profile updated successfully!" : "Leader created successfully!", ToastNotification.ToastType.Success);
            }
            else
            {
                ShowToast("Failed to save leader profile.", ToastNotification.ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Save error: {ex.Message}", ToastNotification.ToastType.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDelete(ApiLeaderItem leader)
    {
        leaderToDelete = leader;
        isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        leaderToDelete = null;
    }

    private async Task ExecuteDelete()
    {
        if (leaderToDelete == null) return;

        try
        {
            isDeleting = true;
            var response = await Http.DeleteAsync($"api/cms/leadership/{leaderToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                ShowToast("Leader deleted successfully!", ToastNotification.ToastType.Success);
                await LoadDataForCurrentLangAsync();
                await CheckLanguageDataAvailabilityAsync();
            }
            else
            {
                ShowToast("Failed to delete leader.", ToastNotification.ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Delete Error: {ex.Message}", ToastNotification.ToastType.Error);
        }
        finally
        {
            isDeleting = false;
            CloseDeleteModal();
        }
    }

    private async Task DeleteUploadedImageAsync(string key)
    {
        if (string.IsNullOrEmpty(key)) return;

        try
        {
            await Http.DeleteAsync($"api/cms/media/delete?bucketName={BucketName}&key={key}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] Failed to delete image from R2: {ex.Message}");
        }
    }

    private async Task<string> GetImageUrlAsync(string bucketName, string key)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PresignedUrlResponseModel>($"api/cms/media/presigned-url?bucketName={bucketName}&key={key}");
            return response?.PresignedUrl ?? string.Empty;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] GetImageUrlAsync Exception: {ex.Message}");
            return string.Empty;
        }
    }

    private void SwitchLanguage()
    {
        currentLang = currentLang == "en" ? "de" : "en";
    }
    
    private void GoBack() => Navigation.NavigateTo("/cms/dashboard");

    private void DismissToast() => toastMessage = null;

    private void ShowToast(string message, ToastNotification.ToastType type)
    {
        toastMessage = message;
        toastType = type;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

