@page "/cms/edit-leadership"
@using GmbhCmsPortalApp.Components.Shared
@layout MainLayout
@attribute [Authorize]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<!-- Notification Toast System -->
@if (toastMessage != null)
{
    <div
        class="fixed top-6 right-6 z-[9999] flex items-center gap-3 px-4 py-3 rounded-lg shadow-md border text-xs font-medium transition-all duration-300 animate-fade-in bg-white border-[#E6E0DD] text-[#2D2424]">
        @if (toastType == ToastType.Success)
        {
            <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
        }
        else
        {
            <div class="w-6 h-6 rounded-full bg-rose-100 text-rose-800 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </div>
        }
        <span class="text-[#2D2424] font-medium tracking-wide">@toastMessage</span>
        <button @onclick="DismissToast" class="ml-3 text-[#735A5A] hover:text-[#2D2424] transition cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>
}

<div class="max-w-5xl mx-auto space-y-8">

    <!-- Page Header & Language Selector -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[#E6E0DD] pb-6 gap-4">
        <div class="flex items-center space-x-4">
            <button @onclick="GoBack"
                    class="bg-white border border-[#D9D0CC] hover:bg-[#F5EFEE] text-[#5C1D24] p-2 rounded-md transition cursor-pointer flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
            </button>
            <div>
                <span class="text-xs uppercase text-[#5C1D24] font-medium block mb-1 tracking-normal">
                    CMS Portal • Content Management
                </span>
                <h1 class="text-2xl font-semibold text-[#2D2424]">
                    Manage Leadership Section
                </h1>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <!-- Reusable Language Switcher Component -->
            <LanguageSwitcher @bind-CurrentLanguage="currentLang"
                              HasEnglishData="@hasEnglishLeaders"
                              HasGermanData="@hasGermanLeaders"/>

            <button @onclick="OpenCreateModal"
                    class="bg-[#5C1D24] hover:bg-[#4A171D] text-[#FCFBFA] px-5 py-2.5 text-xs uppercase font-medium rounded-md transition cursor-pointer flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add New Leader
            </button>
        </div>
    </div>

    <!-- Section Header Settings -->
    <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-[#E6E0DD] pb-2">
            <div class="flex items-center gap-2">
                <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal">
                    Section Header Settings
                </h3>
                <span class="text-[10px] bg-[#E6E0DD] text-[#5C1D24] px-2 py-0.5 rounded font-bold uppercase">
                    @currentLang
                </span>
            </div>
            <button @onclick="SaveHeaderSettings" disabled="@isSavingHeader"
                    class="bg-[#5C1D24] hover:bg-[#4A171D] text-white px-4 py-1.5 text-xs font-medium rounded-md transition flex items-center gap-1.5 disabled:opacity-50 cursor-pointer">
                @if (isSavingHeader)
                {
                    <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor"
                              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save Header (@currentLang.ToUpper())</span>
                }
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                    Subtitle (@currentLang.ToUpper())
                </label>
                <input type="text" @bind="sectionSubtitle"
                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
            </div>
            <div>
                <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                    Main Title (@currentLang.ToUpper())
                </label>
                <input type="text" @bind="sectionTitle"
                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
            </div>
        </div>
    </div>

    <!-- Leadership List Section -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal">
                Leaders List (@leadersList.Count) - Language: <span class="uppercase font-bold">@currentLang</span>
            </h3>
        </div>

        @if (isPageLoading)
        {
            <div
                class="flex flex-col items-center justify-center py-12 space-y-3 bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg">
                <svg class="animate-spin h-8 w-8 text-[#5C1D24]" xmlns="http://www.w3.org/2000/svg" fill="none"
                     viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor"
                          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="text-xs font-medium text-[#5C4D4D]">Loading leadership profiles (@currentLang)...</span>
            </div>
        }
        else if (!leadersList.Any())
        {
            <div class="p-8 text-center bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg text-xs text-[#5C4D4D]">
                No leadership profiles found for "@currentLang.ToUpper()". Click "Add New Leader" to create one.
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @foreach (var leader in leadersList)
                {
                    <div
                        class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg overflow-hidden shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="p-6 flex flex-col items-center text-center border-b border-[#E6E0DD] bg-white">
                                <div
                                    class="w-24 h-24 rounded-full overflow-hidden mb-4 border border-[#E6E0DD] bg-gray-50 flex items-center justify-center">
                                    @if (!string.IsNullOrEmpty(leader.ImageUrl))
                                    {
                                        <img src="@leader.ImageUrl" alt="@leader.Name"
                                             class="w-full h-full object-cover"/>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400">No Image</span>
                                    }
                                </div>
                                <span
                                    class="text-[10px] uppercase font-semibold text-[#5C1D24] tracking-wider mb-1">@leader.Role</span>
                                <h4 class="text-base font-bold text-[#2D2424]">@leader.Name</h4>
                            </div>
                            <div class="p-5 space-y-2">
                                <p class="text-xs text-[#5C4D4D] line-clamp-4">@leader.Bio</p>
                            </div>
                        </div>

                        <div class="px-5 py-3 bg-white border-t border-[#E6E0DD] flex items-center justify-between">
                            <button @onclick="() => OpenEditModal(leader)"
                                    class="text-xs uppercase font-medium text-[#5C1D24] hover:underline flex items-center gap-1 cursor-pointer">
                                Edit
                            </button>
                            <button @onclick="() => PromptDelete(leader)"
                                    class="text-xs uppercase font-medium text-red-700 hover:underline flex items-center gap-1 cursor-pointer">
                                Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (isDeleteModalOpen && leaderToDelete != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div
            class="bg-white rounded-lg shadow-xl w-full max-w-md overflow-hidden border border-[#E6E0DD] p-6 space-y-4">
            <h3 class="text-sm font-semibold uppercase text-red-700">Confirm Delete</h3>
            <p class="text-xs text-[#5C4D4D]">
                Are you sure you want to delete <span class="font-bold text-[#2D2424]">@leaderToDelete.Name</span>? This
                action cannot be undone.
            </p>
            <div class="flex justify-end gap-2 pt-2">
                <button @onclick="CloseDeleteModal" type="button"
                        class="px-4 py-2 text-xs font-medium text-[#5C4D4D] border border-[#D9D0CC] rounded hover:bg-[#F5EFEE] cursor-pointer">
                    Cancel
                </button>
                <button @onclick="ExecuteDelete" disabled="@isDeleting" type="button"
                        class="px-4 py-2 text-xs font-medium text-white bg-red-700 hover:bg-red-800 rounded disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isDeleting)
                    {
                        <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                    stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor"
                                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    }
                    <span>Delete Leader</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Dual Language Create/Edit Modal -->
@if (isModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl overflow-hidden border border-[#E6E0DD] space-y-4">

            <div class="px-6 py-4 bg-[#FCFBFA] border-b border-[#E6E0DD] flex justify-between items-center">
                <h3 class="text-sm font-semibold uppercase text-[#5C1D24]">
                    @(isEditMode ? "Edit Leader Profile" : "Add New Leader (EN & DE)")
                </h3>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <div class="p-6 space-y-4 text-xs max-h-[75vh] overflow-y-auto">
                <!-- Common Fields & Image Upload -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Full Name *</label>
                        <input type="text" @bind="createModel.Name" placeholder="e.g. Win Htein Lin"
                               class="w-full bg-white border border-[#D9D0CC] px-3 py-2 text-sm rounded focus:outline-none focus:border-[#5C1D24]"/>
                    </div>

                    <!-- File Upload Input Block -->
                    <div>
                        <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Profile Image</label>
                        <div class="flex items-center gap-3">
                            <div class="relative flex-1">
                                <InputFile OnChange="HandleFileSelected" accept="image/*"
                                           class="block w-full text-xs text-gray-500 file:mr-3 file:py-2 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-[#5C1D24] file:text-white hover:file:bg-[#4A171D] cursor-pointer border border-[#D9D0CC] rounded"/>
                            </div>
                            @if (isUploading)
                            {
                                <svg class="animate-spin h-5 w-5 text-[#5C1D24]" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                            stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor"
                                          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            }
                        </div>

                        <!-- Preview Area Inside Modal -->
                        @if (!string.IsNullOrEmpty(previewImageUrl))
                        {
                            <div class="mt-2 flex items-center gap-2">
                                <img src="@previewImageUrl" alt="Preview"
                                     class="w-10 h-10 object-cover rounded-full border border-[#E6E0DD]"/>
                                <span
                                    class="text-[10px] text-emerald-700 font-medium truncate">Attached: @selectedFileName</span>
                            </div>
                        }
                    </div>
                </div>

                <hr class="border-[#E6E0DD]"/>

                <!-- English Form Section -->
                <div class="space-y-3 bg-[#FCFBFA] p-4 rounded-md border border-[#E6E0DD]">
                    <h4 class="font-bold text-[#5C1D24] uppercase text-[11px] flex items-center gap-2">
                        🇬🇧 English Details
                    </h4>
                    <div>
                        <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Role (EN)</label>
                        <input type="text" @bind="createModel.RoleEn" placeholder="e.g. Founder"
                               class="w-full bg-white border border-[#D9D0CC] px-3 py-2 text-sm rounded focus:outline-none focus:border-[#5C1D24]"/>
                    </div>
                    <div>
                        <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Bio (EN)</label>
                        <textarea @bind="createModel.BioEn" rows="3" placeholder="English bio..."
                                  class="w-full bg-white border border-[#D9D0CC] px-3 py-2 text-sm rounded focus:outline-none focus:border-[#5C1D24]"></textarea>
                    </div>
                </div>

                <!-- German Form Section -->
                <div class="space-y-3 bg-[#FCFBFA] p-4 rounded-md border border-[#E6E0DD]">
                    <h4 class="font-bold text-[#5C1D24] uppercase text-[11px] flex items-center gap-2">
                        🇩🇪 German Details
                    </h4>
                    <div>
                        <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Role (DE)</label>
                        <input type="text" @bind="createModel.RoleDe" placeholder="e.g. Gründer"
                               class="w-full bg-white border border-[#D9D0CC] px-3 py-2 text-sm rounded focus:outline-none focus:border-[#5C1D24]"/>
                    </div>
                    <div>
                        <label class="block uppercase font-medium text-[#5C4D4D] mb-1">Bio (DE)</label>
                        <textarea @bind="createModel.BioDe" rows="3" placeholder="German bio..."
                                  class="w-full bg-white border border-[#D9D0CC] px-3 py-2 text-sm rounded focus:outline-none focus:border-[#5C1D24]"></textarea>
                    </div>
                </div>
            </div>

            <div class="px-6 py-3 bg-[#FCFBFA] border-t border-[#E6E0DD] flex justify-end gap-2">
                <button @onclick="CloseModal" type="button"
                        class="px-4 py-2 text-xs font-medium text-[#5C4D4D] border border-[#D9D0CC] rounded hover:bg-[#F5EFEE] cursor-pointer">
                    Cancel
                </button>
                <button @onclick="SaveLeader" disabled="@(isSaving || isUploading)" type="button"
                        class="px-4 py-2 text-xs font-medium text-white bg-[#5C1D24] hover:bg-[#4A171D] rounded disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isSaving)
                    {
                        <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                    stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor"
                                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    }
                    <span>Save Leader</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string _currentLang = "en";

    private string currentLang
    {
        get => _currentLang;
        set
        {
            if (_currentLang != value)
            {
                _currentLang = value;
                _ = LoadDataForCurrentLangAsync();
            }
        }
    }

    private string sectionSubtitle = "";
    private string sectionTitle = "";

    private List<LeaderModel> leadersList = new();

    private bool hasEnglishLeaders = false;
    private bool hasGermanLeaders = false;

    private bool isPageLoading = true;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool isUploading = false;
    private bool isSavingHeader = false;

    private bool isModalOpen = false;
    private bool isEditMode = false;
    private LeaderModel activeLeader = new();

    private string previewImageUrl = "";
    private string selectedFileName = "";

    private bool isDeleteModalOpen = false;
    private LeaderModel? leaderToDelete = null;

    private string? toastMessage = null;
    private ToastType toastType = ToastType.Success;

    private const string BucketName = "gmbh"; // S3 / Cloudflare R2 Bucket Name

    private CreateLeaderRequest createModel = new();

    public enum ToastType
    {
        Success,
        Error
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("[LOG-UI] Initializing Leadership Component...");
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is null || !user.Identity.IsAuthenticated)
        {
            Console.WriteLine("[LOG-UI] User not authenticated. Redirecting...");
            Navigation.NavigateTo("/");
            return;
        }

        await CheckLanguageDataAvailabilityAsync();
        await LoadDataForCurrentLangAsync();
    }

    private async Task CheckLanguageDataAvailabilityAsync()
    {
        try
        {
            var enTask = Http.GetFromJsonAsync<List<LeaderModel>>("api/cms/leadership?lang=en");
            var deTask = Http.GetFromJsonAsync<List<LeaderModel>>("api/cms/leadership?lang=de");

            await Task.WhenAll(enTask, deTask);

            hasEnglishLeaders = enTask.Result?.Any() ?? false;
            hasGermanLeaders = deTask.Result?.Any() ?? false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] CheckLanguageDataAvailability failed: {ex.Message}");
        }
    }

    private async Task LoadDataForCurrentLangAsync()
    {
        isPageLoading = true;
        StateHasChanged();
        await Task.WhenAll(LoadHeaderSettingsAsync(), LoadLeadersAsync());
        isPageLoading = false;
        StateHasChanged();
    }

    private async Task LoadHeaderSettingsAsync()
    {
        try
        {
            var header = await Http.GetFromJsonAsync<HeaderResponseModel>($"api/cms/leadership/header?lang={currentLang}");
            if (header != null)
            {
                sectionSubtitle = header.Subtitle ?? string.Empty;
                sectionTitle = header.MainTitle ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] LoadHeaderSettingsAsync: {ex.Message}");
        }
    }

    private async Task SaveHeaderSettings()
    {
        try
        {
            isSavingHeader = true;
            Console.WriteLine($"[LOG-UI] Saving Header Settings for lang: {currentLang}");

            var request = new UpdateHeaderRequest
            {
                Subtitle = sectionSubtitle,
                MainTitle = sectionTitle
            };

            var response = await Http.PutAsJsonAsync($"api/cms/leadership/header?lang={currentLang}", request);
            if (response.IsSuccessStatusCode)
            {
                ShowToast("Header settings updated successfully!", ToastType.Success);
            }
            else
            {
                ShowToast("Failed to update header settings.", ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] SaveHeaderSettings Exception: {ex.Message}");
            ShowToast($"Save Error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isSavingHeader = false;
        }
    }

    private async Task LoadLeadersAsync()
    {
        try
        {
            Console.WriteLine($"[LOG-UI] Fetching Leaders for lang: {currentLang}");
            var response = await Http.GetFromJsonAsync<List<LeaderModel>>($"api/cms/leadership?lang={currentLang}");
            leadersList.Clear();
            if (response != null)
            {
                foreach (var leader in response)
                {
                    if (!string.IsNullOrEmpty(leader.ImageUrl) && !leader.ImageUrl.StartsWith("http"))
                    {
                        leader.ImageUrl = await GetImageUrlAsync(BucketName, leader.ImageUrl);
                    }

                    leadersList.Add(leader);
                }
            }

            if (currentLang == "en") hasEnglishLeaders = leadersList.Any();
            if (currentLang == "de") hasGermanLeaders = leadersList.Any();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] LoadLeadersAsync: {ex.Message}");
        }
    }

    private void OpenCreateModal()
    {
        Console.WriteLine("[LOG-UI] Opening Create Modal...");
        isEditMode = false;
        createModel = new CreateLeaderRequest();
        previewImageUrl = string.Empty;
        selectedFileName = string.Empty;
        isModalOpen = true;
    }

    private async Task OpenEditModal(LeaderModel leader)
    {
        Console.WriteLine($"[LOG-UI] Opening Edit Modal for Leader ID: {leader.Id}");
        isEditMode = true;
        activeLeader = leader;
        isModalOpen = true;
        previewImageUrl = string.Empty;
        selectedFileName = string.Empty;

        try
        {
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var response = await Http.GetAsync($"api/cms/leadership/{leader.Id}/detail");

            if (response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadFromJsonAsync<CreateLeaderRequest>(options);
                if (detail != null)
                {
                    createModel = detail;
                    Console.WriteLine($"[LOG-UI] Fetched Edit Detail ImageUrl: '{createModel.ImageUrl}'");

                    if (!string.IsNullOrEmpty(createModel.ImageUrl))
                    {
                        previewImageUrl = createModel.ImageUrl.StartsWith("http")
                            ? createModel.ImageUrl
                            : await GetImageUrlAsync(BucketName, createModel.ImageUrl);
                    }
                }
            }
            else
            {
                Console.WriteLine($"[LOG-UI-ERROR] Fetch detail failed status: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] OpenEditModal Exception: {ex.Message}");
        }

        await InvokeAsync(StateHasChanged);
    }

    private void CloseModal() => isModalOpen = false;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
        {
            Console.WriteLine("[LOG-UI-WARN] File selection cancelled or null.");
            return;
        }

        selectedFileName = file.Name;
        Console.WriteLine($"[LOG-UI] Selected File: {file.Name}, Size: {file.Size} bytes, Type: {file.ContentType}");

        try
        {
            isUploading = true;
            StateHasChanged();

            var maxFileSize = 40 * 1024 * 1024; // 40 MB

            // 1. File Stream ကို Read Stream အဖြစ် ယူမည်
            using var fileStream = file.OpenReadStream(maxFileSize);

            // 2. Stream ကို MemoryStream ထဲသို့ Copy ကူးယူမည် (Consumed Exception မတက်စေရန်)
            using var memoryStream = new MemoryStream();
            await fileStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0; // Stream ရဲ့ Pointer ကို အစသို့ ပြန်တင်မည်

            // 3. MultipartFormDataContent တွင် MemoryStream ကို အသုံးပြုမည်
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(memoryStream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(streamContent, "file", file.Name);

            var BucketName = "gmbh";
            var uploadUrl = $"api/cms/media/upload?bucketName={BucketName}";
            Console.WriteLine($"[LOG-UI] Posting file to: {uploadUrl}");

            var response = await Http.PostAsync(uploadUrl, content);

            Console.WriteLine($"[LOG-UI] Upload Http Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                var uploadResult = await response.Content.ReadFromJsonAsync<FileUploadResponseModel>();
                Console.WriteLine($"[LOG-UI] Upload Response Received -> Key: '{uploadResult?.FileName}'");

                if (uploadResult != null && !string.IsNullOrEmpty(uploadResult.FileName))
                {
                    createModel.ImageUrl = uploadResult.FileName;

                    Console.WriteLine($"[LOG-UI] Requesting Presigned URL for Preview Key: '{uploadResult.FileName}'");
                    previewImageUrl = await GetImageUrlAsync(BucketName, uploadResult.FileName);
                    Console.WriteLine($"[LOG-UI] Preview URL set: {previewImageUrl}");

                    ShowToast("Image uploaded successfully!", ToastType.Success);
                }
            }
            else
            {
                var errBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[LOG-UI-ERROR] Upload Failed: {errBody}");
                ShowToast($"Upload failed: {response.StatusCode}", ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] HandleFileSelected Exception: {ex.Message}");
            ShowToast($"Upload error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isUploading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveLeader()
    {
        Console.WriteLine($"[LOG-UI] Saving Leader... Name: '{createModel.Name}', ImageKey: '{createModel.ImageUrl}'");
        if (string.IsNullOrWhiteSpace(createModel.Name))
        {
            ShowToast("Please enter Full Name.", ToastType.Error);
            return;
        }

        try
        {
            isSaving = true;
            HttpResponseMessage response = isEditMode
                ? await Http.PutAsJsonAsync($"api/cms/leadership/{activeLeader.Id}", createModel)
                : await Http.PostAsJsonAsync("api/cms/leadership", createModel);

            Console.WriteLine($"[LOG-UI] Save Leader Http Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                await LoadDataForCurrentLangAsync();
                await CheckLanguageDataAvailabilityAsync();
                isModalOpen = false;
                ShowToast(isEditMode ? "Profile updated successfully!" : "Leader created successfully!", ToastType.Success);
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[LOG-UI-ERROR] Save Leader Failed: {err}");
                ShowToast("Failed to save leader profile.", ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] SaveLeader Exception: {ex.Message}");
            ShowToast($"Save error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDelete(LeaderModel leader)
    {
        leaderToDelete = leader;
        isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        leaderToDelete = null;
    }

    private async Task ExecuteDelete()
    {
        if (leaderToDelete == null) return;

        try
        {
            isDeleting = true;
            var response = await Http.DeleteAsync($"api/cms/leadership/{leaderToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                ShowToast("Leader deleted successfully!", ToastType.Success);
                await LoadDataForCurrentLangAsync();
                await CheckLanguageDataAvailabilityAsync();
            }
            else
            {
                ShowToast("Failed to delete leader.", ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] Delete Exception: {ex.Message}");
            ShowToast($"Delete Error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isDeleting = false;
            CloseDeleteModal();
        }
    }

    private async Task<string> GetImageUrlAsync(string bucketName, string key)
    {
        try
        {
            var url = $"api/cms/media/presigned-url?bucketName={bucketName}&key={key}";
            Console.WriteLine($"[LOG-UI] GetImageUrlAsync calling: {url}");
            var response = await Http.GetFromJsonAsync<PresignedUrlResponseModel>(url);
            return response?.PresignedUrl ?? string.Empty;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] GetImageUrlAsync Exception: {ex.Message}");
            return string.Empty;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/cms/dashboard");

    private void DismissToast() => toastMessage = null;

    private void ShowToast(string message, ToastType type)
    {
        toastMessage = message;
        toastType = type;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

