@code {
    private string _currentLang = "en";

    private string currentLang
    {
        get => _currentLang;
        set
        {
            if (_currentLang != value)
            {
                _currentLang = value;
                _ = LoadDataForCurrentLangAsync();
            }
        }
    }

    private string sectionSubtitle = "";
    private string sectionTitle = "";

    private List<ApiServiceItem> servicesList = new();

    private bool hasEnglishServices = false;
    private bool hasGermanServices = false;

    private bool isPageLoading = true;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool isUploading = false;
    private bool isSavingHeader = false;

    private bool isModalOpen = false;
    private bool isEditMode = false;
    private ApiServiceItem activeService = new();

    private string previewImageUrl = "";
    private string selectedFileName = "";
    private string initialImageUrl = "";

    private bool isDeleteModalOpen = false;
    private ApiServiceItem? serviceToDelete = null;

    private string? toastMessage = null;
    private ToastType toastType = ToastType.Success;

    private const string BucketName = "gmbh"; // S3 / Cloudflare R2 Bucket Name

    private CreateServiceDto createModel = new();

    public enum ToastType
    {
        Success,
        Error
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("[LOG-UI] Initializing Service Component...");
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is null || !user.Identity.IsAuthenticated)
        {
            Console.WriteLine("[LOG-UI] User not authenticated. Redirecting...");
            Navigation.NavigateTo("/");
            return;
        }

        await CheckLanguageDataAvailabilityAsync();
        await LoadDataForCurrentLangAsync();
    }

    private async Task CheckLanguageDataAvailabilityAsync()
    {
        try
        {
            var enTask = Http.GetFromJsonAsync<List<ApiServiceItem>>("api/cms/services?lang=en");
            var deTask = Http.GetFromJsonAsync<List<ApiServiceItem>>("api/cms/services?lang=de");

            await Task.WhenAll(enTask, deTask);

            hasEnglishServices = enTask.Result?.Any() ?? false;
            hasGermanServices = deTask.Result?.Any() ?? false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] CheckLanguageDataAvailability failed: {ex.Message}");
        }
    }

    private async Task LoadDataForCurrentLangAsync()
    {
        isPageLoading = true;
        StateHasChanged();
        await Task.WhenAll(LoadHeaderSettingsAsync(), LoadServicesAsync());
        isPageLoading = false;
        StateHasChanged();
    }

    private async Task LoadHeaderSettingsAsync()
    {
        try
        {
            var header = await Http.GetFromJsonAsync<HeaderResponseDto>($"api/cms/services/header?lang={currentLang}");
            if (header != null)
            {
                sectionSubtitle = header.Subtitle ?? string.Empty;
                sectionTitle = header.MainTitle ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] LoadHeaderSettingsAsync: {ex.Message}");
        }
    }

    private async Task SaveHeaderSettings()
    {
        try
        {
            isSavingHeader = true;
            Console.WriteLine($"[LOG-UI] Saving Header Settings for lang: {currentLang}");

            var request = new UpdateHeaderRequest
            {
                Subtitle = sectionSubtitle,
                MainTitle = sectionTitle
            };

            var response = await Http.PutAsJsonAsync($"api/cms/services/header?lang={currentLang}", request);
            if (response.IsSuccessStatusCode)
            {
                ShowToast("Header settings updated successfully!", ToastType.Success);
            }
            else
            {
                ShowToast("Failed to update header settings.", ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] SaveHeaderSettings Exception: {ex.Message}");
            ShowToast($"Save Error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isSavingHeader = false;
        }
    }

    private async Task LoadServicesAsync()
    {
        try
        {
            Console.WriteLine($"[LOG-UI] Fetching Services for lang: {currentLang}");
            var response = await Http.GetFromJsonAsync<List<ApiServiceItem>>($"api/cms/services?lang={currentLang}");
            servicesList.Clear();
            if (response != null)
            {
                foreach (var service in response)
                {
                    if (!string.IsNullOrEmpty(service.ImageUrl) && !service.ImageUrl.StartsWith("http"))
                    {
                        service.ImageUrl = await GetImageUrlAsync(BucketName, service.ImageUrl);
                    }

                    servicesList.Add(service);
                }
            }

            if (currentLang == "en") hasEnglishServices = servicesList.Any();
            if (currentLang == "de") hasGermanServices = servicesList.Any();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] LoadServicesAsync: {ex.Message}");
        }
    }

    private void OpenCreateModal()
    {
        Console.WriteLine("[LOG-UI] Opening Create Service Modal...");
        isEditMode = false;
        createModel = new CreateServiceDto();
        initialImageUrl = string.Empty;
        previewImageUrl = string.Empty;
        selectedFileName = string.Empty;
        isModalOpen = true;
    }

    private async Task OpenEditModal(ApiServiceItem service)
    {
        Console.WriteLine($"[LOG-UI] Opening Edit Modal for Service ID: {service.Id}");
        isEditMode = true;
        activeService = service;
        previewImageUrl = string.Empty;
        selectedFileName = string.Empty;

        createModel = new CreateServiceDto
        {
            ImageUrl = service.ImageUrl ?? string.Empty
        };

        if (currentLang == "en")
        {
            createModel.TitleEn = service.Title;
            createModel.DescriptionEn = service.Description;
        }
        else
        {
            createModel.TitleDe = service.Title;
            createModel.DescriptionDe = service.Description;
        }

        initialImageUrl = createModel.ImageUrl;

        if (!string.IsNullOrEmpty(createModel.ImageUrl))
        {
            previewImageUrl = createModel.ImageUrl.StartsWith("http")
                ? createModel.ImageUrl
                : await GetImageUrlAsync(BucketName, createModel.ImageUrl);
        }

        isModalOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseModal()
    {
        if (!string.IsNullOrEmpty(createModel.ImageUrl) && createModel.ImageUrl != initialImageUrl)
        {
            await DeleteUploadedImageAsync(createModel.ImageUrl);
        }

        isModalOpen = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
        {
            Console.WriteLine("[LOG-UI-WARN] File selection cancelled or null.");
            return;
        }

        selectedFileName = file.Name;
        Console.WriteLine($"[LOG-UI] Selected File: {file.Name}, Size: {file.Size} bytes, Type: {file.ContentType}");

        try
        {
            isUploading = true;
            StateHasChanged();

            var maxFileSize = 40 * 1024 * 1024; // 40 MB

            using var fileStream = file.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await fileStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(memoryStream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(streamContent, "file", file.Name);

            var uploadUrl = $"api/cms/media/upload?bucketName={BucketName}";
            Console.WriteLine($"[LOG-UI] Posting file to: {uploadUrl}");

            var response = await Http.PostAsync(uploadUrl, content);

            Console.WriteLine($"[LOG-UI] Upload Http Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                var uploadResult = await response.Content.ReadFromJsonAsync<FileUploadResponseModel>();
                Console.WriteLine($"[LOG-UI] Upload Response Received -> Key: '{uploadResult?.FileName}'");

                if (uploadResult != null && !string.IsNullOrEmpty(uploadResult.FileName))
                {
                    if (!string.IsNullOrEmpty(createModel.ImageUrl) && createModel.ImageUrl != initialImageUrl)
                    {
                        await DeleteUploadedImageAsync(createModel.ImageUrl);
                    }

                    createModel.ImageUrl = uploadResult.FileName;

                    Console.WriteLine($"[LOG-UI] Requesting Presigned URL for Preview Key: '{uploadResult.FileName}'");
                    previewImageUrl = await GetImageUrlAsync(BucketName, uploadResult.FileName);
                    Console.WriteLine($"[LOG-UI] Preview URL set: {previewImageUrl}");

                    ShowToast("Image uploaded successfully!", ToastType.Success);
                }
            }
            else
            {
                var errBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[LOG-UI-ERROR] Upload Failed: {errBody}");
                ShowToast($"Upload failed: {response.StatusCode}", ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] HandleFileSelected Exception: {ex.Message}");
            ShowToast($"Upload error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isUploading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveService()
    {
        Console.WriteLine($"[LOG-UI] Saving Service... ImageKey: '{createModel.ImageUrl}'");

        // Title ကွက်လပ် ဖြစ်နေပါက အစတည်းက API မခေါ်ဘဲ Toast ပြမည်
        if (string.IsNullOrWhiteSpace(createModel.TitleEn) && string.IsNullOrWhiteSpace(createModel.TitleDe))
        {
            ShowToast("Please enter Service Title.", ToastType.Error);
            return;
        }

        try
        {
            isSaving = true;
            HttpResponseMessage response = isEditMode
                ? await Http.PutAsJsonAsync($"api/cms/services/{activeService.Id}", createModel)
                : await Http.PostAsJsonAsync("api/cms/services", createModel);

            Console.WriteLine($"[LOG-UI] Save Service Http Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                initialImageUrl = createModel.ImageUrl;
                await LoadDataForCurrentLangAsync();
                await CheckLanguageDataAvailabilityAsync();
                isModalOpen = false;
                ShowToast(isEditMode ? "Service updated successfully!" : "Service created successfully!", ToastType.Success);
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[LOG-UI-ERROR] Save Service Failed Status Code: {response.StatusCode}, Details: {err}");
                ShowToast($"Failed to save service details. ({response.StatusCode})", ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] SaveService Exception: {ex.Message}");
            ShowToast($"Save error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDelete(ApiServiceItem service)
    {
        serviceToDelete = service;
        isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        serviceToDelete = null;
    }

    private async Task ExecuteDelete()
    {
        if (serviceToDelete == null) return;

        try
        {
            isDeleting = true;
            var response = await Http.DeleteAsync($"api/cms/services/{serviceToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                ShowToast("Service deleted successfully!", ToastType.Success);
                await LoadDataForCurrentLangAsync();
                await CheckLanguageDataAvailabilityAsync();
            }
            else
            {
                ShowToast("Failed to delete service.", ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] Delete Exception: {ex.Message}");
            ShowToast($"Delete Error: {ex.Message}", ToastType.Error);
        }
        finally
        {
            isDeleting = false;
            CloseDeleteModal();
        }
    }

    private async Task DeleteUploadedImageAsync(string key)
    {
        if (string.IsNullOrEmpty(key)) return;

        try
        {
            var deleteUrl = $"api/cms/media/delete?bucketName={BucketName}&key={key}";
            await Http.DeleteAsync(deleteUrl);
            Console.WriteLine($"[LOG-UI] Deleted temp uploaded file from R2: {key}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] Failed to delete image from R2: {ex.Message}");
        }
    }

    private async Task<string> GetImageUrlAsync(string bucketName, string key)
    {
        try
        {
            var url = $"api/cms/media/presigned-url?bucketName={bucketName}&key={key}";
            Console.WriteLine($"[LOG-UI] GetImageUrlAsync calling: {url}");
            var response = await Http.GetFromJsonAsync<PresignedUrlResponseModel>(url);
            return response?.PresignedUrl ?? string.Empty;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOG-UI-ERROR] GetImageUrlAsync Exception: {ex.Message}");
            return string.Empty;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/cms/dashboard");

    private void DismissToast() => toastMessage = null;

    private void ShowToast(string message, ToastType type)
    {
        toastMessage = message;
        toastType = type;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

