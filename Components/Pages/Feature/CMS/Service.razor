@page "/cms/edit-services"
@using GmbhCmsPortalApp.Components.Shared
@layout MainLayout
@attribute [Authorize]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<!-- Notification Toast System -->
@if (toastMessage != null)
{
    <div
        class="fixed top-6 right-6 z-[9999] flex items-center gap-3 px-4 py-3 rounded-lg shadow-md border text-xs font-medium transition-all duration-300 animate-fade-in bg-white border-[#E6E0DD] text-[#2D2424]">
        @if (toastType == ToastType.Success)
        {
            <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
        }
        else
        {
            <div class="w-6 h-6 rounded-full bg-rose-100 text-rose-800 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </div>
        }
        <span class="text-[#2D2424] font-medium tracking-wide">@toastMessage</span>
        <button @onclick="DismissToast" class="ml-3 text-[#735A5A] hover:text-[#2D2424] transition cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>
}

<div class="max-w-5xl mx-auto space-y-8">

    <!-- Page Header & Language Switcher -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[#E6E0DD] pb-6 gap-4">
        <div class="flex items-center space-x-4">
            <button @onclick="GoBack"
                    class="bg-white border border-[#D9D0CC] hover:bg-[#F5EFEE] text-[#5C1D24] p-2 rounded-md transition cursor-pointer flex items-center justify-center"
                    title="Back">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
            </button>
            <div>
                <span class="text-xs uppercase text-[#5C1D24] font-medium block mb-1 tracking-normal">
                    CMS Portal • Content Management
                </span>
                <h1 class="text-2xl font-semibold text-[#2D2424]">
                    Manage Services Section
                </h1>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <!-- Reusable Language Switcher Component -->
            <LanguageSwitcher @bind-CurrentLanguage="currentLang"
                              HasEnglishData="@hasEnglishServices"
                              HasGermanData="@hasGermanServices"/>

            <!-- Add New Service Button -->
            <button @onclick="OpenCreateModal"
                    class="bg-[#5C1D24] hover:bg-[#4A171D] text-[#FCFBFA] px-5 py-2.5 text-xs uppercase font-medium rounded-md transition cursor-pointer flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add New Service
            </button>
        </div>
    </div>

    <!-- Section Header Settings Card -->
    <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-[#E6E0DD] pb-2">
            <div class="flex items-center gap-2">
                <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal">
                    Section Header Settings
                </h3>
                <span class="text-[10px] bg-[#E6E0DD] text-[#5C1D24] px-2 py-0.5 rounded font-bold uppercase">
                    @currentLang
                </span>
            </div>
            <button @onclick="SaveHeaderSettings" disabled="@isSavingHeader"
                    class="bg-[#5C1D24] hover:bg-[#4A171D] text-white px-4 py-1.5 text-xs font-medium rounded-md transition flex items-center gap-1.5 disabled:opacity-50 cursor-pointer">
                @if (isSavingHeader)
                {
                    <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor"
                              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save Header (@currentLang.ToUpper())</span>
                }
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                    Subtitle (@currentLang.ToUpper())
                </label>
                <input type="text" @bind="sectionSubtitle"
                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
            </div>
            <div>
                <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                    Main Title (@currentLang.ToUpper())
                </label>
                <input type="text" @bind="sectionTitle"
                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
            </div>
        </div>
    </div>

    <!-- Services List Section -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal">
                Services List (@servicesList.Count) - Language: <span class="uppercase font-bold">@currentLang</span>
            </h3>
        </div>

        @if (isPageLoading)
        {
            <div
                class="flex flex-col items-center justify-center py-12 space-y-3 bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg">
                <svg class="animate-spin h-8 w-8 text-[#5C1D24]" xmlns="http://www.w3.org/2000/svg" fill="none"
                     viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor"
                          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="text-xs font-medium text-[#5C4D4D]">Loading services (@currentLang)...</span>
            </div>
        }
        else if (!servicesList.Any())
        {
            <div class="p-8 text-center bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg text-xs text-[#5C4D4D]">
                No services found for "@currentLang.ToUpper()". Click "Add New Service" to create one.
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @foreach (var service in servicesList)
                {
                    <div
                        class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg overflow-hidden shadow-sm flex flex-col justify-between">
                        <div>
                            <div
                                class="h-40 bg-gray-50 border-b border-[#E6E0DD] relative flex items-center justify-center overflow-hidden">
                                @if (!string.IsNullOrEmpty(service.ImageUrl))
                                {
                                    <img src="@service.ImageUrl" alt="@service.Title"
                                         class="w-full h-full object-cover"/>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400">No Image</span>
                                }
                            </div>
                            <div class="p-5 space-y-2">
                                <h4 class="text-base font-bold text-[#2D2424]">
                                    @service.Title
                                </h4>
                                <p class="text-xs text-[#5C4D4D] line-clamp-3">
                                    @service.Description
                                </p>
                            </div>
                        </div>

                        <div class="px-5 py-3 bg-white border-t border-[#E6E0DD] flex items-center justify-between">
                            <button @onclick="() => OpenEditModal(service)"
                                    class="text-xs uppercase font-medium text-[#5C1D24] hover:underline flex items-center gap-1 cursor-pointer">
                                Edit
                            </button>
                            <button @onclick="() => PromptDelete(service)"
                                    class="text-xs uppercase font-medium text-red-700 hover:underline flex items-center gap-1 cursor-pointer">
                                Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- Delete Confirmation Modal -->
@if (isDeleteModalOpen && serviceToDelete != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div
            class="bg-white rounded-lg shadow-xl w-full max-w-md overflow-hidden border border-[#E6E0DD] p-6 space-y-4">
            <h3 class="text-sm font-semibold uppercase text-red-700">Confirm Delete</h3>
            <p class="text-xs text-[#5C4D4D]">
                Are you sure you want to delete <span class="font-bold text-[#2D2424]">@serviceToDelete.Title</span>?
                This action cannot be undone.
            </p>
            <div class="flex justify-end gap-2 pt-2">
                <button @onclick="CloseDeleteModal" type="button"
                        class="px-4 py-2 text-xs font-medium text-[#5C4D4D] border border-[#D9D0CC] rounded hover:bg-[#F5EFEE] cursor-pointer">
                    Cancel
                </button>
                <button @onclick="ExecuteDelete" disabled="@isDeleting" type="button"
                        class="px-4 py-2 text-xs font-medium text-white bg-red-700 hover:bg-red-800 rounded disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isDeleting)
                    {
                        <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                    stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor"
                                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    }
                    <span>Delete Service</span>
                </button>
            </div>
        </div>
    </div>
}

