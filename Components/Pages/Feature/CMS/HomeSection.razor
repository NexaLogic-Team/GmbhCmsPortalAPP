@page "/cms/edit-home"
@using GmbhCmsPortalApp.Components.Common
@using GmbhCmsPortalApp.Components.Shared
@layout MainLayout
@attribute [Authorize]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<!-- Notification Toast System -->
<ToastNotification Message="@toastMessage" Type="@toastType" OnDismiss="DismissToast" />

<div class="max-w-4xl mx-auto space-y-6 relative">

    <!-- Page Header & Language Switcher -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[#E6E0DD] pb-6 gap-4">
        <div>
            <span class="text-xs uppercase text-[#5C1D24] font-medium block mb-1 tracking-normal">
                CMS Portal • Content Management
            </span>
            <h1 class="text-2xl font-semibold text-[#2D2424]">
                Edit Home Section (Hero)
            </h1>
        </div>

        <div class="flex items-center gap-4">
            <!-- Language Selector -->
            <div class="inline-flex bg-[#E6E0DD]/60 p-1 rounded-md gap-1">
                <button type="button" 
                        @onclick='() => currentLang = "en"'
                        class="px-3 py-1.5 text-xs font-medium rounded transition flex items-center gap-1.5 @(currentLang == "en" ? "bg-[#5C1D24] text-[#FCFBFA]" : "text-[#735A5A] hover:text-[#2D2424]")">
                    @if (currentLang == "en")
                    {
                        <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
                    }
                    🇬🇧 English
                </button>
                <button type="button" 
                        @onclick='() => currentLang = "de"'
                        class="px-3 py-1.5 text-xs font-medium rounded transition flex items-center gap-1.5 @(currentLang == "de" ? "bg-[#5C1D24] text-[#FCFBFA]" : "text-[#735A5A] hover:text-[#2D2424]")">
                    @if (currentLang == "de")
                    {
                        <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
                    }
                    🇩🇪 German
                </button>
            </div>

            <button @onclick="HandleSave" 
                    disabled="@(isLoading || isUploading)"
                    class="bg-[#5C1D24] hover:bg-[#4A171D] text-[#FCFBFA] px-6 py-2.5 text-xs uppercase font-medium rounded-md transition cursor-pointer disabled:opacity-50 flex items-center gap-2">
                @if (isLoading) 
                { 
                    <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Saving...</span> 
                } 
                else 
                { 
                    <span>Save Changes</span> 
                }
            </button>
        </div>
    </div>

    <!-- Edit Form Card Container -->
    <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-8 shadow-sm relative overflow-hidden space-y-6">
        
        <!-- Loading Overlay -->
        @if (isPageLoading)
        {
            <div class="absolute inset-0 bg-[#FCFBFA]/90 backdrop-blur-[2px] z-50 flex flex-col items-center justify-center space-y-3">
                <div class="w-8 h-8 border-3 border-[#E6E0DD] border-t-[#5C1D24] rounded-full animate-spin"></div>
                <span class="text-xs font-medium uppercase text-[#5C1D24] tracking-wider">
                    Loading home content...
                </span>
            </div>
        }

        <!-- Language Reminder Banner -->
        <div class="bg-[#5C1D24]/10 border border-[#5C1D24]/20 p-3 rounded-md text-xs text-[#5C1D24] font-medium flex justify-between items-center">
            <span>You are editing: <strong class="uppercase">@(currentLang == "en" ? "English (EN)" : "German (DE)")</strong>. Remember to check both language tabs before saving!</span>
            <button type="button" @onclick="SwitchLanguage" class="underline font-bold hover:opacity-80 cursor-pointer">
                Switch to @(currentLang == "en" ? "German 🇩🇪" : "English 🇬🇧") ➔
            </button>
        </div>

        <!-- Hero Media (Image / Video) Upload & Preview Section -->
        <div class="border border-[#E6E0DD] rounded-md p-5 bg-white space-y-4">
            <h3 class="text-xs uppercase font-semibold text-[#5C1D24] tracking-normal border-b border-[#E6E0DD] pb-2">
                Hero Background Media (Image or Video)
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
                <div>
                    <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2">
                        Upload Media File (Image / MP4 Video)
                    </label>
                    <div class="flex items-center gap-3">
                        <InputFile OnChange="HandleFileSelected" accept="image/*,video/mp4"
                                   class="block w-full text-xs text-gray-500 file:mr-3 file:py-2 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-[#5C1D24] file:text-white hover:file:bg-[#4A171D] cursor-pointer border border-[#D9D0CC] rounded" />
                        @if (isUploading)
                        {
                            <svg class="animate-spin h-5 w-5 text-[#5C1D24]" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(selectedFileName))
                    {
                        <span class="text-[10px] text-emerald-700 font-medium mt-1 block">Selected: @selectedFileName</span>
                    }
                </div>

                <!-- Preview Box -->
                <div>
                    <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2">
                        Media Preview
                    </label>
                    <div class="w-full h-40 rounded-md border border-[#D9D0CC] bg-[#F5EFEE] overflow-hidden flex items-center justify-center relative">
                        @if (!string.IsNullOrEmpty(previewMediaUrl))
                        {
                            @if (homeModel.MediaType == "video")
                            {
                                <video src="@previewMediaUrl" controls class="w-full h-full object-cover"></video>
                            }
                            else
                            {
                                <img src="@previewMediaUrl" alt="Hero Preview" class="w-full h-full object-cover" />
                            }
                        }
                        else
                        {
                            <span class="text-xs text-gray-400">No media uploaded</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <EditForm Model="homeModel" OnValidSubmit="HandleSave">
            <div class="space-y-6">

                <!-- Main Title Input -->
                <div>
                    <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                        Main Title (@(currentLang.ToUpper()))
                    </label>
                    @if (currentLang == "en")
                    {
                        <InputText @bind-Value="homeModel.MainTitleEn"
                                   class="w-full bg-white border border-[#D9D0CC] px-3.5 py-3 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    }
                    else
                    {
                        <InputText @bind-Value="homeModel.MainTitleDe"
                                   class="w-full bg-white border border-[#D9D0CC] px-3.5 py-3 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    }
                </div>

                <!-- Description Paragraph Input -->
                <div>
                    <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                        Description Paragraph 1 (@(currentLang.ToUpper()))
                    </label>
                    @if (currentLang == "en")
                    {
                        <InputTextArea @bind-Value="homeModel.Description1En" rows="4"
                                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-3 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    }
                    else
                    {
                        <InputTextArea @bind-Value="homeModel.Description1De" rows="4"
                                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-3 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    }
                </div>

            </div>
        </EditForm>
    </div>

</div>

@code {
    private string currentLang = "en";
    private bool isPageLoading = true;
    private bool isLoading = false;
    private bool isUploading = false;

    private string previewMediaUrl = string.Empty;
    private string selectedFileName = string.Empty;
    private const string BucketName = "gmbh";

    private string? toastMessage;
    private ToastNotification.ToastType toastType = ToastNotification.ToastType.Success;

    private HomeSectionDto homeModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadHomeContentAsync();
    }

    private async Task LoadHomeContentAsync()
    {
        try
        {
            isPageLoading = true;
            var response = await Http.GetFromJsonAsync<HomeSectionDto>("api/cms/home");
            if (response != null)
            {
                homeModel = response;
                if (!string.IsNullOrEmpty(homeModel.HeroMediaUrl))
                {
                    previewMediaUrl = homeModel.HeroMediaUrl.StartsWith("http")
                        ? homeModel.HeroMediaUrl
                        : await GetImageUrlAsync(BucketName, homeModel.HeroMediaUrl);
                }
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Failed to load home section: {ex.Message}", ToastNotification.ToastType.Error);
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        selectedFileName = file.Name;
        homeModel.MediaType = file.ContentType.Contains("video") ? "video" : "image";

        try
        {
            isUploading = true;
            StateHasChanged();

            const long maxFileSize = 100 * 1024 * 1024; // 100 MB max for video/images

            using var fileStream = file.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await fileStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(memoryStream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(streamContent, "file", file.Name);

            var response = await Http.PostAsync($"api/cms/media/upload?bucketName={BucketName}", content);

            if (response.IsSuccessStatusCode)
            {
                var uploadResult = await response.Content.ReadFromJsonAsync<FileUploadResponseModel>();
                if (uploadResult != null && !string.IsNullOrEmpty(uploadResult.FileName))
                {
                    homeModel.HeroMediaUrl = uploadResult.FileName;
                    previewMediaUrl = await GetImageUrlAsync(BucketName, uploadResult.FileName);
                    ShowToast("Media uploaded successfully!", ToastNotification.ToastType.Success);
                }
            }
            else
            {
                ShowToast($"Upload failed: {response.StatusCode}", ToastNotification.ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Upload error: {ex.Message}", ToastNotification.ToastType.Error);
        }
        finally
        {
            isUploading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<string> GetImageUrlAsync(string bucketName, string key)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PresignedUrlResponseModel>($"api/cms/media/presigned-url?bucketName={bucketName}&key={key}");
            return response?.PresignedUrl ?? string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

    private void SwitchLanguage()
    {
        currentLang = currentLang == "en" ? "de" : "en";
    }

    private async Task HandleSave()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var response = await Http.PutAsJsonAsync("api/cms/home", homeModel);

            if (response.IsSuccessStatusCode)
            {
                ShowToast("Home section updated successfully!", ToastNotification.ToastType.Success);
            }
            else
            {
                ShowToast("Failed to save changes. Please try again.", ToastNotification.ToastType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}", ToastNotification.ToastType.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void DismissToast() => toastMessage = null;

    private void ShowToast(string message, ToastNotification.ToastType type)
    {
        toastMessage = message;
        toastType = type;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    public class HomeSectionDto
    {
        public string MainTitleEn { get; set; } = string.Empty;
        public string Description1En { get; set; } = string.Empty;
        public string MainTitleDe { get; set; } = string.Empty;
        public string Description1De { get; set; } = string.Empty;
        public string HeroMediaUrl { get; set; } = string.Empty;
        public string MediaType { get; set; } = "image";
    }

    public class FileUploadResponseModel
    {
        public string FileName { get; set; } = string.Empty;
    }

    public class PresignedUrlResponseModel
    {
        public string PresignedUrl { get; set; } = string.Empty;
    }
}