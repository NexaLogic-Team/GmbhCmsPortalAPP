@page "/cms/change-password"
@using System.ComponentModel.DataAnnotations
@using GmbhCmsPortalApp.Components.Service
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<div class="max-w-md mx-auto my-10 p-6 bg-[#FCFBFA] border border-[#E6E0DD] rounded-xl shadow-sm">
    <div class="mb-6">
        <h2 class="text-xl font-semibold text-[#2D2424]">Change Password</h2>
        <p class="text-xs text-[#735A5A] mt-1">Update your account password below.</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-xs text-red-600">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="mb-4 p-3 bg-green-50 border border-green-200 rounded-lg text-xs text-green-700">
            @successMessage
        </div>
    }

    <EditForm Model="@changePasswordModel" OnValidSubmit="HandleChangePassword">
        <DataAnnotationsValidator />

        <!-- Current Password -->
        <div class="mb-4">
            <label class="block text-xs font-medium text-[#2D2424] mb-1">Current Password</label>
            <InputText @bind-Value="changePasswordModel.CurrentPassword" 
                       type="password" 
                       class="w-full px-3 py-2 text-xs bg-white border border-[#D9D0CC] rounded-lg focus:outline-none focus:border-[#5C1D24]" 
                       placeholder="Enter current password" />
            <ValidationMessage For="@(() => changePasswordModel.CurrentPassword)" class="text-[11px] text-red-500 mt-1" />
        </div>

        <!-- New Password -->
        <div class="mb-4">
            <label class="block text-xs font-medium text-[#2D2424] mb-1">New Password</label>
            <InputText @bind-Value="changePasswordModel.NewPassword" 
                       type="password" 
                       class="w-full px-3 py-2 text-xs bg-white border border-[#D9D0CC] rounded-lg focus:outline-none focus:border-[#5C1D24]" 
                       placeholder="Enter new password (min. 6 characters)" />
            <ValidationMessage For="@(() => changePasswordModel.NewPassword)" class="text-[11px] text-red-500 mt-1" />
        </div>

        <!-- Confirm Password -->
        <div class="mb-6">
            <label class="block text-xs font-medium text-[#2D2424] mb-1">Confirm New Password</label>
            <InputText @bind-Value="confirmPassword" 
                       type="password" 
                       class="w-full px-3 py-2 text-xs bg-white border border-[#D9D0CC] rounded-lg focus:outline-none focus:border-[#5C1D24]" 
                       placeholder="Re-enter new password" />
            @if (confirmPasswordTouched && changePasswordModel.NewPassword != confirmPassword)
            {
                <span class="text-[11px] text-red-500 mt-1 block">Passwords do not match.</span>
            }
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end gap-3">
            <button type="button" 
                    @onclick="Cancel"
                    class="px-4 py-2 text-xs font-medium text-[#5C4D4D] bg-white border border-[#D9D0CC] rounded-lg hover:bg-[#E6E0DD]/30 transition cursor-pointer">
                Cancel
            </button>
            <button type="submit" 
                    disabled="@isSubmitting"
                    class="px-4 py-2 text-xs font-medium text-white bg-[#5C1D24] rounded-lg hover:bg-[#4A171D] disabled:opacity-50 transition cursor-pointer">
                @(isSubmitting ? "Updating..." : "Update Password")
            </button>
        </div>
    </EditForm>
</div>

@code {
    private ChangePasswordDto changePasswordModel = new();
    private string confirmPassword = string.Empty;
    private bool confirmPasswordTouched => !string.IsNullOrEmpty(confirmPassword);

    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting = false;

    private async Task HandleChangePassword()
    {
        errorMessage = null;
        successMessage = null;

        if (changePasswordModel.NewPassword != confirmPassword)
        {
            errorMessage = "New password and Confirm password do not match.";
            return;
        }

        isSubmitting = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/cms/auth/change-password", changePasswordModel);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Password updated successfully. Redirecting to login...";
                
                // User ကို Message မြင်ရအောင် 1.5 Seconds စောင့်ပေးခြင်း
                await Task.Delay(1500);

                // Logout Action ပြုလုပ်ခြင်း
                await HandleLogoutAfterPasswordChange();
            }
            else
            {
                var result = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                errorMessage = result?.Message ?? "Failed to change password. Please check your current password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleLogoutAfterPasswordChange()
    {
        // LocalStorage မှ Token ဖျက်ရန်
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");

        // AuthStateProvider ကို Update လုပ်ပြီး Logout Notification ပေးရန်
        if (AuthStateProvider is CustomJwtAuthenticationStateProvider customAuthProv)
        {
            customAuthProv.NotifyUserLogout();
        }

        // Login Screen (/) သို့ Force Reload လုပ်ပြီး Navigate လုပ်ရန်
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/cms/profile");
    }

    public class ChangePasswordDto
    {
        [Required(ErrorMessage = "Current password is required.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "New password is required.")]
        [MinLength(6, ErrorMessage = "New password must be at least 6 characters long.")]
        public string NewPassword { get; set; } = string.Empty;
    }
    private class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}