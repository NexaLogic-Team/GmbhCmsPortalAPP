@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-md overflow-hidden border border-[#E6E0DD] p-6 space-y-4">
            <h3 class="text-sm font-semibold uppercase text-red-700">Confirm Delete</h3>
            <p class="text-xs text-[#5C4D4D]">
                Are you sure you want to delete <span class="font-bold text-[#2D2424]">@ItemName</span>? This action cannot be undone.
            </p>
            <div class="flex justify-end gap-2 pt-2">
                <button @onclick="OnCancel" type="button"
                        class="px-4 py-2 text-xs font-medium text-[#5C4D4D] border border-[#D9D0CC] rounded hover:bg-[#F5EFEE] cursor-pointer">
                    Cancel
                </button>
                <button @onclick="OnConfirm" disabled="@IsDeleting" type="button"
                        class="px-4 py-2 text-xs font-medium text-white bg-red-700 hover:bg-red-800 rounded disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (IsDeleting)
                    {
                        <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    }
                    <span>@ButtonText</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string ItemName { get; set; } = string.Empty;
    [Parameter] public string ButtonText { get; set; } = "Delete";
    [Parameter] public bool IsDeleting { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
}