@inject UserProfileState ProfileState
@inject NavigationManager NavigationManager
@using GmbhCmsPortalApp.Components.Service
@implements IDisposable

<header class="h-20 bg-[#FCFBFA] border-b border-[#E6E0DD] flex items-center justify-between px-8 z-20">
    <div class="flex items-center gap-4">
        <span class="text-xs uppercase font-medium text-[#5C4D4D] tracking-normal">Workspace</span>
    </div>

    <!-- Right Navbar Actions -->
    <div class="relative">
        <button @onclick="ToggleDropdown"
                class="flex items-center gap-3 bg-white border border-[#D9D0CC] hover:border-[#5C1D24] px-4 py-2.5 rounded-lg text-xs font-medium text-[#2D2424] transition cursor-pointer">
            
            <img src="@(string.IsNullOrEmpty(ProfileState.Profile?.ProfileImage) ? "/Logo/default_avatar.png" : ProfileState.Profile.ProfileImage)" 
                 alt="Admin Avatar" 
                 class="w-6 h-6 rounded-full object-cover border border-[#5C1D24]" />
            
            <span>@(ProfileState.Profile?.FullName ?? ProfileState.Profile?.Username ?? "Admin")</span>

            <svg xmlns="http://www.w3.org/2000/svg"
                 class="h-3.5 w-3.5 text-[#735A5A] transition-transform duration-200 @(isDropdownOpen ? "rotate-180" : "")"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
        </button>

        @if (isDropdownOpen)
        {
            <div class="absolute right-0 mt-2 w-48 bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg shadow-lg py-1.5 z-50">
                <!-- Profile Link -->
                <a href="/cms/profile"
                   @onclick="CloseDropdown"
                   class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-[#2D2424] hover:bg-[#E6E0DD]/50 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#735A5A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    Profile
                </a>

                <!-- Change Password Link (ADDED) -->
                <a href="/cms/change-password"
                   @onclick="CloseDropdown"
                   class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-[#2D2424] hover:bg-[#E6E0DD]/50 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#735A5A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                    Change Password
                </a>

                <div class="border-t border-[#E6E0DD] my-1"></div>

                <!-- Logout Button -->
                <button @onclick="HandleLogout"
                        class="w-full flex items-center gap-2.5 px-4 py-2.5 text-xs text-[#5C1D24] hover:bg-[#5C1D24]/10 transition text-left cursor-pointer border-0 bg-transparent">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#5C1D24]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    Logout
                </button>
            </div>
        }
    </div>
</header>

@code {
    private bool isDropdownOpen = false;

    protected override async Task OnInitializedAsync()
    {
        ProfileState.OnChange += OnProfileStateChanged;

        if (!ProfileState.IsLoaded)
        {
            await ProfileState.InitializeAsync();
        }
    }

    private async void OnProfileStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void CloseDropdown()
    {
        isDropdownOpen = false;
    }

    private void HandleLogout()
    {
        isDropdownOpen = false;
        ProfileState.ClearCache();
        NavigationManager.NavigateTo("/api/logout", true);
    }

    public void Dispose()
    {
        ProfileState.OnChange -= OnProfileStateChanged;
    }
}